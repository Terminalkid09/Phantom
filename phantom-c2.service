# Phantom C2 Server - systemd service template
# Copia in /etc/systemd/system/phantom-c2.service
# sudo systemctl daemon-reload && sudo systemctl enable --now phantom-c2

[Unit]
Description=Phantom C2 Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=phantom
WorkingDirectory=/opt/phantom
Environment=PATH=/opt/phantom/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/phantom
ExecStart=/opt/phantom/venv/bin/python -m phantom.core.c2_shell
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/phantom/data

[Install]
WantedBy=multi-user.target
