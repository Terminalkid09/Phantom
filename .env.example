# Phantom Framework Environment Variables

# ── AI Integration (optional) ───────────────────────────────────────────────
AI_PROVIDER=
AI_API_KEY=
AI_ENDPOINT=
AI_MODEL=

# ── C2 Encryption (AES-256-GCM) ───────────────────────────────────────────
# Key must be exactly 32 bytes; Nonce must be exactly 12 bytes.
# Recompile beacons after changing these (generate / deploy-agent).
PHANTOM_C2_KEY=
PHANTOM_C2_NONCE=

# Token required to download compiled beacon binaries from the C2 server.
PHANTOM_PAYLOAD_TOKEN=

# ── External APIs ─────────────────────────────────────────────────────────
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# Without a key: 5 requests / 30s. With key: 50 requests / 30s.
NVD_API_KEY=

# WiFi geolocation uses Apple WLOC — free, no API key, no config needed
