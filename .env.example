[TEMPLATE]
# Phantom Framework Environment Variables
#
# IMPORTANT — Phantom is now ZERO-CONFIG by default: run `setup` in the
# shell (or `setup auto`) and your settings live in data/config.json
# (gitignored, auto-created). These env vars are OPTIONAL overrides that
# take precedence over the config file when set — you no longer need a .env
# at all for the local lab / C2 / tracker.
#
# C2 key, payload token, API token and beacon-auth secrets are created on
# first use and stored in data/phantom_state.json (gitignored, 0600).
# Only fill in the values below for external services Phantom cannot guess.

# ── AI Integration (optional) ───────────────────────────────────────────────

# ── External APIs ─────────────────────────────────────────────────────────
# NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# Without a key: 5 requests / 30s. With key: 50 requests / 30s.
NVD_API_KEY=

# WiFi geolocation uses Apple WLOC — free, no API key, no config needed

# ── Social Engineering (OSINT / phish / breach / SMS) ─────────────────────
# Breach-dump API (self-hosted or aggregator) exposing plaintext creds.
PHANTOM_BREACH_API=

# HaveIBeenPwned v3 API key (https://haveibeenpwned.com/API/Key).
PHANTOM_HIBP_API_KEY=

# SMTP relay for phish email + email-to-SMS (free tiers: SMTP2GO / Brevo).
PHANTOM_SMTP_HOST=
PHANTOM_SMTP_PORT=
PHANTOM_SMTP_USER=
PHANTOM_SMTP_PASSWORD=
PHANTOM_SMTP_TLS=1

# Self-hosted IP-grabber / credential-harvest server (victim links).
PHANTOM_TRACK_URL=
PHANTOM_TRACK_HOST=0.0.0.0
PHANTOM_TRACK_PORT=8080
# Where the victim lands after the click (use a convincing decoy).
PHANTOM_TRACK_REDIRECT=https://example.com
# Brand shown on the fake login page (credential harvesting).
PHANTOM_TRACK_BRAND=Account verification
# "1" adds an OTP/2FA field to the fake login page.
PHANTOM_TRACK_OTP=0
# Video-lure skin for IP grabbing: instagram | tiktok | youtube (reel/short
# page that looks like the platform and plays a real embedded video).
PHANTOM_TRACK_SKIN=youtube
# YouTube video id embedded in the lure player (default: a harmless public video).
PHANTOM_TRACK_VIDEO_ID=
# Optional MaxMind .mmdb for geo on captured IPs.
PHANTOM_GEOIP_DB=

# Coherent persona cover: "offline" (Pillow gradient+initials avatar, default)
# or "randomuser" (fetch a free portrait photo, cached locally under data/personas/).
PHANTOM_PERSONA_AVATAR=offline
# Sender address used for phish email. When empty, Phantom derives it from
# the target dossier: the SERVICE they use (e.g. noreply@linkedin.com) or a
# colleague at the corporate domain discovered by OSINT.
PHANTOM_PHISH_FROM=
# Cyrillic homoglyph obfuscation of the sender display name + subject: a
# stealth tool, ON by default, OFF in aggressive mode. 0/1 to force.
PHANTOM_PHISH_HOMOGLYPH=1
# How long the auto-mode sleeps waiting for the human during social
# engineering (email open / link click / DM / follow accept) before it
# escalates. Default: 600s stealth, 30s with the fast flag.
PHANTOM_SOCIAL_WAIT=600

# Force the email-to-SMS carrier gateway when auto-detection fails.
PHANTOM_SMS_CARRIER=


# ── Local LLM advisor (optional, non-gating) ──────────────────────────────
# Path to a GGUF model for the `auto --llm` hypothesis advisor. Recommended
# default: Qwen2.5-3B-Instruct Q4 (or 1.5B on weak CPUs; swap for a 7B/13B
# GGUF on GPU boxes for stronger reasoning). Nothing ever leaves your machine.
# Install the runtime once: pip install llama-cpp-python
PHANTOM_LLM_MODEL=


# Telegram
PHANTOM_TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to control the bot
PHANTOM_TELEGRAM_ALLOWED_USERS=

# Social DM: Discord webhook (alternative Telegram-free DM channel)
PHANTOM_DISCORD_WEBHOOK=

# Social DM: custom transport class (dotted path) for X/Reddit/Instagram DMs
PHANTOM_DM_TRANSPORT=

# Log4Shell PoC: your LDAP listener for callback confirmation, e.g. ldap://10.0.0.5:1389/x
PHANTOM_LOG4J_CALLBACK=

# ── Overrides (only for advanced setups) ───────────────────────────────────
# All of these are auto-generated in data/phantom_state.json.
# Uncomment and set them ONLY when you need to share secrets across machines
# or run multiple listeners with different material.

# PHANTOM_C2_KEY=
# PHANTOM_C2_NONCE=
# PHANTOM_PAYLOAD_TOKEN=
# PHANTOM_API_TOKEN=
# PHANTOM_PM_KEY=            # AES key for .pm session bundles (auto-generated)
#                            # WARNING: changing it makes old .pm files unreadable
# PHANTOM_BEACON_AUTH_REQUIRED=1
# PHANTOM_MTLS_REQUIRED=1
# PHANTOM_MTLS_CERT_DIR=data/certs
# PHANTOM_MTLS_CA=

# ── Optional LLM advisor transport (auto-mode `--llm`) ────────────────────
# DEFAULT is LOCAL: a GGUF model on this machine. Nothing leaves the box.
# PHANTOM_LLM_MODEL=C:\models\qwen2.5-7b-instruct-q4_k_m.gguf
#
# ALTERNATIVE — an always-on OpenAI-compatible endpoint (e.g. a free
# Workers-AI deployment) so no model runs on the operator's machine.
# PHANTOM_LLM_BACKEND=remote
# PHANTOM_LLM_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# PHANTOM_LLM_API_KEY=
# PHANTOM_LLM_REMOTE_MODEL=@cf/meta/llama-3.1-8b-instruct
# NOTE: on the remote path every message is REDACTED first (IPs, hosts,
# domains, users, paths, secrets) — the model reasons on the situation, not
# on your engagement's data. On the local path nothing is redacted or sent.

# ── Self-improvement loop (auto-mode `--evolution`, needs --llm) ───────────
# The author sub-agent uses the SAME LLM transport as the advisor above
# (remote-first recommended: authoring needs a strong code model).
# Publishing: token for opening PRs on auto-evolution/* — create a fine-
# grained PAT limited to this repo + the auto-evolution/* branch namespace.
# PHANTOM_EVOLUTION_TOKEN=
# Without a token the branch is committed locally with push instructions;
# nothing is lost, nothing is pushed silently. Budgets: 5 gate runs/day,
# 2 PRs/day. The lab (docker compose up) must be reachable: no lab, no PR.

# ── Engagement gates (also configurable via `setup`) ───────────────────────
# PHANTOM_ALLOW_UNSCOPED=1       # lab/CTF: allow targeted commands without a scope
# PHANTOM_RANSOM_SIM_ALLOW=1     # allow ransomware SIMULATION (scratch dirs only)
